<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xp.starsite</groupId>
        <artifactId>star-site-platform-file-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>file-dal</artifactId>
    <name>file-dal</name>
    <description>文件域 DAL 数据访问层：MyBatis 官方 mapper + XML，SQL 全收敛在 XML（FileStorage 端口适配器 LocalFileStorage / OssFileStorage 暂驻本模块）</description>

    <dependencies>
        <dependency>
            <groupId>com.xp.starsite</groupId>
            <artifactId>file-core-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xp.starsite</groupId>
            <artifactId>star-site-common</artifactId>
        </dependency>
        <!-- MyBatis 官方 starter（替代 MyBatis-Plus）：版本由根 pom 统一管理 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <!-- OssFileStorage 适配器（JDK9+ 需补 jaxb） -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.17.4</version>
        </dependency>
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>2.3.3</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
