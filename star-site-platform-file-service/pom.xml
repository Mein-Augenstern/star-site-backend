<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xp.starsite</groupId>
        <artifactId>star-site-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>star-site-platform-file-service</artifactId>
    <name>star-site-platform-file-service</name>
    <description>文件微服务（COLA 风格多模块聚合工程）：报告与头像等文件的上传下载</description>
    <packaging>pom</packaging>

    <!-- 六边形：domain 定义 FileStorage 端口，infrastructure 放 Local/OSS 适配器 -->
    <modules>
        <module>file-facade</module>
        <module>file-domain</module>
        <module>file-infrastructure</module>
        <module>file-app</module>
        <module>file-adapter</module>
        <module>file-start</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
