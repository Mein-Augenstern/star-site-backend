<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xp.starsite</groupId>
    <artifactId>star-site-platform-bench-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>bench-start</artifactId>
  <name>bench-start</name>
  <description>压测服务启动模块</description>

  <dependencies>
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>star-site-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 三组件 starter -->
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-sequence-spring-boot-starter</artifactId>
      <version>0.2.2</version>
    </dependency>
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-async-command-spring-boot-starter</artifactId>
      <version>0.2.2</version>
    </dependency>
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-lock-spring-boot-starter</artifactId>
      <version>0.2.2</version>
    </dependency>
    <!-- Web + MyBatis + MySQL -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- star-site-common 将 mybatis 定为 provided（DbDigestInterceptor 编译期需要），
         宿主必须自带；bench 走组件 jdbc 存储，运行期经 autoconfigure.exclude 关掉 MyBatis 装配 -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>3.0.3</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Nacos 服务注册 -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
