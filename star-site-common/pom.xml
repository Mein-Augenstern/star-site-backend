<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xp.starsite</groupId>
        <artifactId>star-site-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>star-site-common</artifactId>
    <name>star-site-common</name>
    <description>公共模块：统一响应、异常、JWT 工具</description>

    <dependencies>
        <!-- AOP 切面（RpcClientAspect 等）：Spring Boot 管理版本 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- 只引注解所需的 spring-web / validation-api（不带 servlet 容器），
             保证 WebFlux 网关也能依赖本模块而不被强制成 SERVLET 应用 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- HandlerInterceptor 所在包；provided 不传染给 WebFlux 网关 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <!-- 各服务运行期解析 token 用（网关/业务服务都受益） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 可复用的 MVC JWT 拦截器：provided 不传染给 WebFlux 网关 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MQ 封装用：事件体 JSON 序列化（含 LocalDateTime 支持） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- digest 日志体系：Feign 出站留痕（provided，由各业务服务自带 openfeign-starter） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-openfeign-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- RocketMQ：provided，需要发消息的业务服务自己引 starter
             （否则网关/未用 MQ 的服务也会被传染 rocketmq-client） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- （原幂等基类 JdbcTemplate provided 依赖已移除：内核改用 starsite-idempotent，
             spring-jdbc 由 idempotent 核心库传递提供） -->

        <!-- DbDigestInterceptor（SQL 摘要拦截器）仅编译期需要 mybatis，provided
             （业务服务自带 mybatis starter 传递提供；运行期由宿主服务的类加载器解析） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 通用组件库（starsite-sequence 雪花 + starsite-async-command 异步命令）：
             engine 与调度器本体在组件仓，backend 仅做策略编排与兼容门面。
             0.2.1：方言 XML 迁移 sql/ → dialect/（避开 ShardingSphere JDBC 仓储
             对 classpath sql/ 目录 XML 的 JAXB 扫描冲突——分片形态实装实证）。
             0.2.3 全线对齐：idempotent-starter 0.2.3 传递依赖 sequence-starter 0.2.3，
             混版（0.2.2 core + 0.2.3 starter）classpath 风险，统一升 0.2.3 -->
        <dependency>
            <groupId>com.xp.starsite</groupId>
            <artifactId>starsite-sequence</artifactId>
            <version>0.2.3</version>
        </dependency>
        <dependency>
            <groupId>com.xp.starsite</groupId>
            <artifactId>starsite-async-command-spring-boot-starter</artifactId>
            <version>0.2.3</version>
        </dependency>
        <!-- 分布式锁组件（定时任务多实例防重跑等；db 模式复用各服务 MyBatis + DataSource，
             锁行主键由上面的 sequence 组件发号——引 jar 即用） -->
        <dependency>
            <groupId>com.xp.starsite</groupId>
            <artifactId>starsite-lock-spring-boot-starter</artifactId>
            <version>0.2.3</version>
        </dependency>
        <!-- API 幂等键组件（Stripe 同款语义：重复请求回放首次成功结果、FAILED 释放键重执行）：
             MQ 幂等消费基类 AbstractIdempotentConsumer 的内核（替换原 event_consume 手工表，
             修复「业务失败后幂等行已落库 → MQ 重投被跳过 → 失败事件永不重试」缺陷）。
             starter 传递依赖 sequence-starter 0.2.3，与上面 sequence 对齐 -->
        <dependency>
            <groupId>com.xp.starsite</groupId>
            <artifactId>starsite-idempotent-spring-boot-starter</artifactId>
            <version>0.2.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
