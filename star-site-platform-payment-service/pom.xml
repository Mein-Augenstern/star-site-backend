<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xp.starsite</groupId>
        <artifactId>star-site-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>star-site-platform-payment-service</artifactId>
    <name>star-site-platform-payment-service</name>
    <description>支付微服务（SOFA 风格多模块聚合工程）：统一支付单/退款/渠道回调状态机，渠道 SPI + 支付宝/微信/mock 适配器。平台级服务：会员订阅、保险代收等商业闭环的收银台</description>
    <packaging>pom</packaging>

    <modules>
        <module>payment-facade</module>
        <module>payment-core-model</module>
        <module>payment-dal</module>
        <module>payment-integration</module>
        <module>payment-core-service</module>
        <module>payment-common-biz</module>
        <module>payment-adapter</module>
        <module>payment-start</module>
    </modules>

    <properties>
        <alipay-sdk.version>4.38.200.ALL</alipay-sdk.version>
        <wechatpay-java.version>0.2.14</wechatpay-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.alipay.sdk</groupId>
                <artifactId>alipay-sdk-java</artifactId>
                <version>${alipay-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.wechatpay-apiv3</groupId>
                <artifactId>wechatpay-java</artifactId>
                <version>${wechatpay-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
