<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xp.starsite</groupId>
        <artifactId>star-site-platform-payment-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>payment-facade</artifactId>
    <name>payment-facade</name>
    <description>payment 服务对外契约（SOFA facade）：PaymentInternalApi + 支付单快照 DTO。业务服务（保险代收/会员订阅）只依赖本模块，禁止依赖 payment 实现</description>

    <dependencies>
        <!-- Feign 契约注解：provided，调用方自带 spring-cloud-starter-openfeign -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-openfeign-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.xp.starsite</groupId>
            <artifactId>star-site-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
