<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xp.starsite</groupId>
        <artifactId>star-site-biz-health-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>health-dal</artifactId>
    <name>health-dal</name>
    <description>健康域 DAL 数据访问层：MyBatis 官方 mapper + XML，屏蔽存储引擎（MySQL/Lindorm/TBase 可换）</description>

    <dependencies>
        <!-- 分阶段迁移过渡：visit 域已迁 DO，其余四域（report/indicator/daily/pregnancy）仍用 core-model 实体，迁完后移除本依赖 -->
        <dependency>
            <groupId>com.xp.starsite</groupId>
            <artifactId>health-core-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MyBatis 官方 starter（替代 MyBatis-Plus）：版本由根 pom 统一管理 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
