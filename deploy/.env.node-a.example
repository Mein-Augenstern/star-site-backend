# node-a 部署环境变量样例（复制为 .env.node-a-<公网IP> 使用；真实文件已 gitignore，不入库）
ACR_PREFIX=star-site
IMAGE_TAG=latest
DISCOVERY_IP_A=<节点内网IP>
DISCOVERY_IP_B=<节点内网IP>
NACOS_ADDR=<节点内网IP>:8848
MYSQL_HOST=star-mysql
MYSQL_ROOT_PASSWORD=<强随机密码>
JWT_SECRET=<强随机32字节>
WX_MP_APPID=<微信小程序AppID>
WX_MP_SECRET=<微信小程序AppSecret>
ADMIN_MEMBER_IDS=<管理员memberId>
LLM_API_KEY=<智谱GLM_API_KEY>
FILE_STORAGE_TYPE=local
FRP_SERVER_ADDR=<ECS公网IP>
FRP_TOKEN=<frp强随机token>
