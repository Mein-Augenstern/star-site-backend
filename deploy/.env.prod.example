# 复制为 .env.prod 并填写真实值（此文件不进 git）
# ===== 镜像仓库（ACR 个人版实例）=====
# 例：registry.cn-hangzhou.aliyuncs.com/star-site
ACR_PREFIX=

# ===== 镜像 tag（release.sh 自动填 git sha，可覆盖）=====
IMAGE_TAG=latest

# ===== 节点内网 IP（同 VPC；ip addr 看 eth0）=====
DISCOVERY_IP_A=172.16.0.10
DISCOVERY_IP_B=172.16.0.11
NACOS_ADDR=172.16.0.10:8848
MYSQL_HOST=172.16.0.10

# ===== 密钥（生产必改）=====
MYSQL_ROOT_PASSWORD=change-me-strong
JWT_SECRET=change-me-32bytes-minimum-production-secret!!

# ===== 微信登录（可选，空=mock 通道）=====
WX_MP_APPID=wx8bb4b89c676c6df8
WX_MP_SECRET=

# ===== 管理员白名单（异步任务管控台；空=所有登录用户）=====
ADMIN_MEMBER_IDS=

# ===== AI（可选）=====
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 文件存储（双机后建议 oss；过渡期 local 且 file 服务只在 node-b）=====
FILE_STORAGE_TYPE=local
