<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xp.starsite</groupId>
        <artifactId>star-site-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>star-site-platform-reminder-service</artifactId>
    <name>star-site-platform-reminder-service</name>
    <description>提醒中心微服务（COLA 风格多模块聚合工程）：领域事件消费落规则、每日扫描生成实例、站内/邮件通知</description>
    <packaging>pom</packaging>

    <!-- COLA：adapter=触发器（REST/MQ 监听/定时扫描），app=用例编排，domain=模型，dal=数据访问（mapper XML）+邮件网关 -->
    <modules>
        <module>reminder-facade</module>
        <module>reminder-core-model</module>
        <module>reminder-dal</module>
        <module>reminder-core-service</module>
        <module>reminder-adapter</module>
        <module>reminder-start</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
